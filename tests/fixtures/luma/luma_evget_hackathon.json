oners.", "event_count": 4177, "hero_image_desktop_url": "https://images.lumacdn.com/uploads/42/5719a861-c421-4624-a9dc-8b8b73e3cf57.png", "icon_url": "https://images.lumacdn.com/uploads/0z/c1143c0e-a2ab-4434-b82b-80b0ba3ec2f0.png", "name": "AI", "page_title": "AI Events", "simple_icon_url": "https://images.lumacdn.com/uploads/2g/4121b0fa-bd9e-4a50-ad85-cf0000b6d919.png", "slug": "ai", "social_image_url": "https://images.lumacdn.com/uploads/c1/486065e1-2511-4577-a0e0-5eb683d38a3d.png", "subscriber_count": 99220, "tint_color": "#D96D9B"}], "ticket_info": {"price": null, "is_free": true, "max_price": null, "is_sold_out": false, "spots_remaining": 341, "is_near_capacity": false, "require_approval": true}, "registration_availability": "open", "subscribed_to_calendar": false, "event_invite": null, "manager_info": null, "guest_info": null, "host_info": null, "sold_out": false, "locale": "en", "theme_meta": {"theme": "warp"}, "tint_color": "#146AEB", "can_register_for_multiple_tickets": false, "font_title": "roc-grotesk", "description_mirror": {"type": "doc", "content": [{"type": "heading", "attrs": {"level": 1}, "content": [{"text": "Where Europe and Asia Meet at the Frontier.", "type": "text"}]}, {"type": "paragraph", "content": [{"text": "Organized by Erasmus AI Society and Maastricht AI Network from the Netherlands and hosted at the Hong Kong University of Science and Technology Business School by HKUST MBA and Entrepreneurship Center.", "type": "text"}]}, {"type": "paragraph", "content": [{"text": "In line with connecting students and builders from two continents, the hackathon theme is ", "type": "text"}, {"text": "BUILD ACROSS", "type": "text", "marks": [{"type": "bold"}]}, {"text": ", with students competing in three challenge tracks: ", "type": "text"}, {"text": "Finance", "type": "text", "marks": [{"type": "italic"}]}, {"text": ", ", "type": "text"}, {"text": "Urbanization", "type": "text", "marks": [{"type": "italic"}]}, {"text": " and ", "type": "text"}, {"text": "Startup", "type": "text", "marks": [{"type": "italic"}]}, {"text": ".", "type": "text"}]}, {"type": "heading", "attrs": {"level": 2}, "content": [{"text": "BUILD ACROSS - Finance", "type": "text"}]}, {"type": "paragraph", "content": [{"text": "Build across the financial system - capital markets, payments, risk and compliance. These are problems where an AI system has to be accurate, auditable and fast, and where the distance between a convincing demo and something an institution could actually run is the real challenge.", "type": "text"}]}, {"type": "heading", "attrs": {"level": 2}, "content": [{"text": "BUILD ACROSS - Urbanization", "type": "text"}]}, {"type": "paragraph", "content": [{"text": "Build across the city - mobility, housing, energy, logistics and public services. Hong Kong is one of the densest urban environments on earth, which makes it an unusually honest test bed for tools meant to make cities work better for the people living in them.", "type": "text"}]}, {"type": "heading", "attrs": {"level": 2}, "content": [{"text": "BUILD ACROSS - Startup", "type": "text"}]}, {"type": "paragraph", "content": [{"text": "Build across the zero-to-one gap - find a real problem, ship something people can actually use, and show why it could become a company. Judged less on polish than on whether the idea still holds up once someone tries to break it.", "type": "text"}]}, {"type": "heading", "attrs": {"level": 2}, "content": [{"text": "THE SUMMIT AT LARGE", "type": "text"}]}, {"type": "paragraph", "content": [{"text": "The hackathon is augmented by a number of side activities, from a symposium, reception at the Dutch Consul General's residence, visit to the Hong Kong Science and Technology Parks as well as local startups and companies. More information on the summit website: aisummit.hk", "type": "text"}]}]}, "eth_address_requirement": null, "faqs": null, "name_requirement": "full-name", "phone_number_requirement": "required", "solana_address_requirement": null, "registration_questions": [{"id": "jzoem9u7", "label": "University", "options": ["HKUST", "HKU", "CUHK", "HKBU", "CityU", "PolyU", "Exchange Student", "Other"], "required": true, "question_type": "dropdown"}, {"id": "xr8uup66", "label": "For exchange students: home university name", "required": false, "question_type": "text"}, {"id": "938wn6av", "label": "Study Program", "required": true, "question_type": "text"}, {"id": "gscsmkqx", "label": "Track Preference", "options": ["Finance", "Urbanization", "Startup"], "required": false, "question_type": "multi-select"}, {"id": "mrft918j", "label": "Team name (leave blank if you want to get matched)", "required": false, "question_type": "text"}, {"id": "ot6o7et3", "label": "What's your experience with AI?", "options": ["Absolute beginner", "Intermediate", "Expert"], "required": false, "question_type": "dropdown"}], "is_flagged": false, "is_managing_calendar_admin": false, "show_unlock_code_option": false, "has_multiple_ticket_types": false, "membership_tiers": [], "membership_info": null, "waitlist_active": false, "route": null, "featured_city": null}