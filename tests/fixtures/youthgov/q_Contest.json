00","published":true,"remarks":null,"revision_action":"","show_on_mobile_application":false,"show_only_date_remarks":false,"slug":"20260629114050-178912-40395","source":"internal","start_date":"2026-07-19T16:00:00.000000Z","start_time":null,"status":"published","tags":[{"id":"tags::competitions","title":"Competitions","slug":"competitions","url":"\/en\/tags\/competitions","permalink":"https:\/\/www.youth.gov.hk\/en\/tags\/competitions","api_url":null}],"title":"\u201cOur \u2018Land\u2019: Past, Present, Future\u201d Photo and Short Video Contest","unpublish_date":"2026-09-20T16:00:00.000000Z","updated_at":"2026-07-20T02:23:35.000000Z","updated_by":null,"uri":"\/community-participation\/events\/fc357178-341e-4912-a055-f646a22e9b03","url":"\/en\/community-participation\/events\/fc357178-341e-4912-a055-f646a22e9b03","venue":{"address":null,"coordinates":null},"root_id":"483bbcad-0506-4fc3-a3b1-1db5b04b55fd","render_content":"<div class=\"container container--narrow\"><div class=\"ckec\"><p><strong>Theme: Our \u201cLand\u201d: Past, Present, Future<\/strong><\/p><p>Every Footprint Tells a Story \u2013 Embracing Memories, Mapping New Horizons<\/p><p>Objective: To celebrate the 45th Anniversary of the Lands Department in 2027, you are invited to capture through your lens the evolving landscapes, urban-rural harmony, the stories woven into our land and architecture, and the visions of tomorrow.<\/p><p>Application period : From 20 July 2026 to 20 September 2026<\/p><p>Details of contest and application: <a href=\"https:\/\/www.landsd.gov.hk\/en\/45a.html\">https:\/\/www.landsd.gov.hk\/en\/45a.html<\/a><\/p><p>Groups :<\/p><ul><li><p>Group 1 : Photos of Open Group<\/p><\/li><li><p>Group 2 : Short Videos of Open Group<\/p><\/li><li><p>Group 3 : Photos of Parents-Children Group<\/p><\/li><li><p>Group 4 : Short Videos of Parents-Children Group<\/p><\/li><\/ul><p>Prizes : One champion, one 1st runner-up, one 2nd runner-up and 5 merit awards for each group.<\/p><ul><li><p>Champion:\u00a0\u00a0\u00a0\u00a0\u00a0 \u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0 HK$5,000 gift voucher<\/p><\/li><li><p>1st Runner-up: \u00a0\u00a0\u00a0\u00a0\u00a0\u00a0HK$3,000 gift voucher<\/p><\/li><li><p>2nd Runner-up:\u00a0\u00a0\u00a0\u00a0\u00a0 HK$2,000 gift voucher<\/p><\/li><li><p>Merit Awards: \u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0 HK$500 gift voucher each<\/p><\/li><\/ul><p>Each winner\/winning group will receive a set of souvenirs featuring the Lands Department mascot, \u201cLandsB.\u201d.<\/p><p>All participants will receive electronic certificates of participation, and all winners will additionally receive printed certificates of award.<\/p><p>Results will be announced on the Lands Department\u2019s website, hkmapping Facebook and Instagram pages in the first quarter of 2027. \u00a0Winners will be notified by email of the results and details regarding prize collection.<\/p><\/div><\/div>"}],"links":{"first":"https:\/\/www.youth.gov.hk\/api\/collections\/events\/entries?filter%5Btitle%3Acontains%5D=Contest&limit=100&page=1","last":"https:\/\/www.youth.gov.hk\/api\/collections\/events\/entries?filter%5Btitle%3Acontains%5D=Contest&limit=100&page=1","prev":null,"next":null},"meta":{"current_page":1,"from":1,"last_page":1,"links":[{"url":null,"label":"&laquo; Previous","active":false},{"url":"https:\/\/www.youth.gov.hk\/api\/collections\/events\/entries?filter%5Btitle%3Acontains%5D=Contest&limit=100&page=1","label":"1","active":true},{"url":null,"label":"Next &raquo;","active":false}],"path":"https:\/\/www.youth.gov.hk\/api\/collections\/events\/entries","per_page":100,"to":5,"total":5}}