","origin_id":"dc124870-2531-4b71-a883-6f90755cab52","permalink":"https:\/\/www.youth.gov.hk\/en\/cultural-leisure\/events\/a57dd121-055d-48d5-a3a9-8f1b427c1769","pgm_code":null,"phone":"2606 6554","private":false,"publish_date":"2026-09-13 09:01:00","published":true,"remarks":"Only for age 6 or above<br>","revision_action":null,"show_on_mobile_application":false,"show_only_date_remarks":true,"slug":"supernova-singers-singing-contest-2026","source":"import","start_date":"2026-10-24T16:00:00.000000Z","start_time":null,"status":"published","tags":[{"id":"tags::event","title":"Event","slug":"event","url":"\/en\/tags\/event","permalink":"https:\/\/www.youth.gov.hk\/en\/tags\/event","api_url":null},{"id":"tags::lcsd","title":"LCSD","slug":"lcsd","url":"\/en\/tags\/lcsd","permalink":"https:\/\/www.youth.gov.hk\/en\/tags\/lcsd","api_url":null}],"title":"Supernova Singers Singing Contest 2026","type":"lcsd_e_magazine","unpublish_date":"2026-10-25T16:00:00.000000Z","updated_at":"2026-09-13T01:01:00.000000Z","updated_by":null,"uri":"\/cultural-leisure\/events\/a57dd121-055d-48d5-a3a9-8f1b427c1769","url":"\/en\/cultural-leisure\/events\/a57dd121-055d-48d5-a3a9-8f1b427c1769","venue":{"address":"Sha Tin Town Hall (Exhibition Gallery)","coordinates":null},"root_id":"dc124870-2531-4b71-a883-6f90755cab52","render_content":""},{"activity_deep_link_id":null,"api_url":null,"application_deadline":"2026-09-19T16:00:00.000000Z","application_method":"Enrollments to be submitted via the online platform(https:\/\/www.landsd.gov.hk\/en\/45a.html).","blueprint":{"title":"Event","handle":"event"},"categories":[{"id":"categories::community-participation","title":"Community Participation","slug":"community-participation","url":"\/en\/categories\/community-participation","permalink":"https:\/\/www.youth.gov.hk\/en\/categories\/community-participation","api_url":null}],"category_handle":"community-participation","collection":{"title":"Events","handle":"events"},"content":[{"type":"text","text":"<p><strong>Theme: Our \u201cLand\u201d: Past, Present, Future<\/strong><\/p><p>Every Footprint Tells a Story \u2013 Embracing Memories, Mapping New Horizons<\/p><p>Objective: To celebrate the 45th Anniversary of the Lands Department in 2027, you are invited to capture through your lens the evolving landscapes, urban-rural harmony, the stories woven into our land and architecture, and the visions of tomorrow.<\/p><p>Application period : From 20 July 2026 to 20 September 2026<\/p><p>Details of contest and application: <a href=\"https:\/\/www.landsd.gov.hk\/en\/45a.html\">https:\/\/www.landsd.gov.hk\/en\/45a.html<\/a><\/p><p>Groups :<\/p><ul><li><p>Group 1 : Photos of Open Group<\/p><\/li><li><p>Group 2 : Short Videos of Open Group<\/p><\/li><li><p>Group 3 : Photos of Parents-Children Group<\/p><\/li><li><p>Group 4 : Short Videos of Parents-Children Group<\/p><\/li><\/ul><p>Prizes : One champion, one 1st runner-up, one 2nd runner-up and 5 merit awards for each group.<\/p><ul><li><p>Champion:\u00a0\u00a0\u00a0\u00a0\u00a0 \u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0 HK$5,000 gift voucher<\/p><\/li><li><p>1st Runner-up: \u00a0\u00a0\u00a0\u00a0\u00a0\u00a0HK$3,000 gift voucher<\/p><\/li><li><p>2nd Runner-up:\u00a0\u00a0\u00a0\u00a0\u00a0 HK$2,000 gift voucher<\/p><\/li><li><p>Merit Awards: \u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0 HK$500 gift voucher each<\/p><\/li><\/ul><p>Each winner\/winning group will receive a set of souvenirs featuring the Lands Department mascot, \u201cLandsB.\u201d.<\/p><p>All participants will receive electronic certificates of participation, and all winners will additionally receive printed certificates of award.<\/p><p>Results will be announced on the Lands Department\u2019s website, hkmapping Facebook and Instagram pages in the first quarter of 2027. \u00a0Winners will be notified by email of the results and details regarding prize collection.<\/p>"}],"cover_image_banner":{"id":"collections::event\/ld-45a-en.jpg","url":"https:\/\/www.youth.gov.h